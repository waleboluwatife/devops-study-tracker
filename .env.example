# Copy to .env and adjust. All configuration comes from environment variables (12-factor).
DATABASE_URL="postgresql://tracker:tracker@localhost:5433/tracker"

# Auth.js — generate a secret with: npx auth secret
AUTH_SECRET="change-me"
# GitHub OAuth app (github.com/settings/developers → New OAuth App)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
# Optional: Google sign-in as well (console.cloud.google.com → Credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Local/testing only: sign in by typing an invited email. Ignored on Vercel.
AUTH_DEV_LOGIN="0"

# Seed: email of the first admin (Michael), so they can sign in and invite the others.
SEED_ADMIN_EMAIL=""

# Screenshots: Vercel Blob in production; local folder when no token is set.
BLOB_READ_WRITE_TOKEN=""
UPLOAD_DIR=".uploads"
